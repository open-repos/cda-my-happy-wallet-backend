{
  "name": "projet-00-myhappywallet-backend",
  "version": "1.1.0",
  "description": "Dans ce projet je mettrais toutes les tâches liées au Backend de mon projet \"Chef d'oeuvre\" CDA .",
  "main": "index.js",
  "scripts": {
    "db:pull": "npx prisma db pull",
    "prisma:generate": "npx prisma generate",
    "watch": "npx tsc -w",
    "dev": "nodemon dist/index.js",
    "start": "node ./dist/index.js",
    "build": "npx tsc",
    "type-check": "npx tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --check package.json .eslintrc.json",
    "db:migrate": "npx prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:visualize": "npx prisma studio",
    "test:rav": "ts-node test/modules/operationsFixes/ResteAVivreCalculator.test.ts",
    "test:services": "npm run test:rav",
    "test:mailer": "ts-node test/modules/user/FakeMailer.test.ts",
    "test:smtp-mailer": "ts-node test/modules/user/SmtpMailer.test.ts",
    "test:create-user": "ts-node test/modules/user/CreateUser.test.ts",
    "test:token-service": "ts-node test/modules/auth/TokenService.test.ts",
    "test:security-config": "ts-node test/modules/auth/SecurityConfig.test.ts",
    "test:auth-rate-limit": "ts-node test/modules/auth/AuthRateLimit.test.ts",
    "test:http-limits": "ts-node test/modules/security/HttpRequestLimits.test.ts",
    "test:cors": "ts-node test/modules/security/CorsPolicy.test.ts",
    "test:password-reset": "ts-node test/modules/auth/PasswordResetSecurity.test.ts",
    "test:refresh-sessions": "ts-node test/modules/auth/RefreshSessionRepository.test.ts",
    "test:refresh-session-service": "ts-node test/modules/auth/RefreshSessionService.test.ts",
    "test:native-session": "ts-node test/modules/auth/NativeSessionApi.test.ts",
    "test:renew-session": "ts-node test/modules/auth/RenewSession.test.ts",
    "test:health": "ts-node test/modules/health/HealthRoutes.test.ts",
    "test:delete-revenu-route": "ts-node test/modules/operationsFixes/DeleteRevenuRoute.test.ts",
    "test:operations-domain": "ts-node test/modules/operations/OneOffOperation.test.ts",
    "test:operations-migration": "ts-node test/modules/operations/OneOffOperationMigration.test.ts prepare && prisma migrate deploy && ts-node test/modules/operations/OneOffOperationMigration.test.ts verify",
    "test:operations-schema": "ts-node test/modules/operations/OneOffOperationSchema.test.ts",
    "test:operations-use-cases": "ts-node test/modules/operations/OneOffOperationUseCases.test.ts",
    "test:operations-repositories": "ts-node test/modules/operations/OneOffOperationRepositories.test.ts",
    "test:prisma-errors": "ts-node test/modules/errors/PrismaErrorHandling.test.ts",
    "test:result-construction": "ts-node test/modules/ResultConstruction.test.ts",
    "test:repositories": "ts-node test/modules/repositories/RepositoriesDataAccess.test.ts",
    "test:api": "ts-node test/modules/api/ApiCharacterization.test.ts",
    "test": "npm run type-check && npm run test:operations-domain"
  },
  "repository": {
    "type": "git",
    "url": "git@gitlab.com:formation-cda1/projet-chef-oeuvre-rapport/projet-00-myhappywallet-backend.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "4.17.25",
    "@types/jsonwebtoken": "9.0.10",
    "@types/morgan": "1.9.10",
    "@types/node": "22.20.1",
    "@types/nodemailer": "6.4.24",
    "@types/supertest": "7.2.1",
    "@types/swagger-ui-express": "4.1.8",
    "@typescript-eslint/parser": "8.64.0",
    "eslint": "8.57.1",
    "nodemon": "3.1.14",
    "prettier": "2.8.8",
    "supertest": "7.2.2",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@sendgrid/mail": "8.1.6",
    "argon2": "0.45.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "16.6.1",
    "express": "4.22.2",
    "express-rate-limit": "8.6.1",
    "helmet": "8.3.0",
    "joi": "17.13.4",
    "joi-to-swagger": "6.2.0",
    "jsonwebtoken": "9.0.3",
    "morgan": "1.11.0",
    "nodemailer": "9.0.3",
    "prisma": "6.19.3",
    "swagger-ui-express": "5.0.1"
  },
  "prisma": {
    "schema": "./src/database/schema.prisma",
    "seed": "ts-node ./src/database/seed.ts"
  }
}
