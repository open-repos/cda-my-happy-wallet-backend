//   typeOperation TypeOperationEnum
//   operations Operation[]
// }

model Periodique {
  idPeriodique  Int       @id @default(autoincrement())
  operations Operation @relation(fields:[idPeriodique], references:[id])
  periode        String?   @db.VarChar(7)
  occurence      Int?
  debutOccurence DateTime? @db.Date
  finOccurence   DateTime? @db.Date
}

// model Ponctuel {
//   idPonctuel  Int       @id @default(autoincrement())
//   operations Operation @relation(fields:[idPonctuel], references:[id])
// }

model ResteAVivre {
  idRaV               Int       @id @default(autoincrement())
  montantRaV          Decimal  @db.Decimal(10, 0) @default(0)
  montantTotalDepense Decimal  @db.Decimal(10, 0) @default(0)
  montantTotalEntree  Decimal  @db.Decimal(10, 0) @default(0)
  created_at          DateTime @default(now()) @db.Timestamp(0)
  updated_at          DateTime @default(now()) @db.DateTime(0)
  User Utilisateur @relation(fields: [userId],references: [id])
  userId Int
}

model ResteAVivreFictif {
  idRaVf              Int       @id @default(autoincrement())
  montantRaVf         Decimal  @db.Decimal(10, 0)
  montantTotalDepense Decimal  @db.Decimal(10, 0)
  montantTotalEntree  Decimal  @db.Decimal(10, 0)
  created_at          DateTime @default(now()) @db.Timestamp(0)
  updated_at          DateTime @default(now()) @db.DateTime(0)
  userId              Int
  User Utilisateur @relation(fields: [userId],references: [id])
}

enum TypeOperationEnum{
  DEPENSE
  ENTREE
}

enum TypeOperationFixeEnum{
  CHARGE
  REVENU
}

enum Role{
  ADMIN
  USER
}


/// A recurring monthly variable budget; deletion through the API archives it.
model BudgetEnvelope {
  id          Int @id @default(autoincrement())
  userId      Int
  title       String @db.VarChar(50)
  amount      Decimal @db.Decimal(10, 2)
  currency    String @db.Char(3)
  categoryId  Int?
  startMonth  DateTime @db.Date
  endMonth    DateTime? @db.Date
  archived    Boolean @default(false)
  createdAt   DateTime @default(now()) @db.Timestamp(0)
  updatedAt   DateTime @updatedAt @db.DateTime(0)
  user        Utilisateur @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    OperationCategory? @relation(fields: [categoryId, userId], references: [id, userId], onDelete: Restrict)
  occurrences ReconciliationOccurrence[]
  @@unique([id, userId])
  @@index([categoryId, userId])
  @@index([userId, currency, id])
}

/// Immutable source snapshot. An explicit open-month override only changes planned.
model ReconciliationOccurrence {
  id             Int @id @default(autoincrement())
  userId         Int
  month          DateTime @db.Date
  sourceKey      String @db.VarChar(40)
  sourceType     ReconciliationSourceType
  envelopeId     Int?
  fixedSourceId  Int?
  title          String @db.VarChar(50)
  currency       String @db.Char(3)
  kind           TypeOperationEnum
  referenceTotal Decimal @db.Decimal(10, 2)
  personalShare  Decimal @db.Decimal(5, 2)
  planned        Decimal @db.Decimal(10, 2)
  categoryId     Int?
  createdAt      DateTime @default(now()) @db.Timestamp(0)
  user           Utilisateur @relation(fields: [userId], references: [id], onDelete: Cascade)
  envelope       BudgetEnvelope? @relation(fields: [envelopeId, userId], references: [id, userId], onDelete: Restrict)
  links          ReconciliationLink[]
  @@unique([id, userId])
  @@unique([userId, month, sourceKey])
  @@index([userId, month, currency, id])
  @@index([envelopeId, userId])
}

/// A link is metadata, never a financial movement.
model ReconciliationLink {
  operationId  Int @id
  userId       Int
  occurrenceId Int
  createdAt    DateTime @default(now()) @db.Timestamp(0)
  operation    OneOffOperationRecord @relation(fields: [operationId, userId], references: [id, userId], onDelete: Cascade)
  occurrence   ReconciliationOccurrence @relation(fields: [occurrenceId, userId], references: [id, userId], onDelete: Restrict)
  @@index([occurrenceId, userId])
  @@unique([operationId, userId])
}

enum ReconciliationSourceType {
  ENVELOPE
  FIXED_EXPENSE
  FIXED_INCOME
}


/// Dated replacement of a fixed definition; only current/future months writable.
model FixedOperationVersion {
  id Int @id @default(autoincrement())
  userId Int
  operationId Int
  effectiveMonth DateTime @db.Date
  payload Json
  createdAt DateTime @default(now()) @db.Timestamp(0)
  operation OperationFixe @relation(fields: [operationId, userId], references: [idOperationFixe, userId], onDelete: Cascade)
  @@unique([operationId, effectiveMonth])
  @@index([userId, effectiveMonth, operationId])
}
