model OperationFixe {
  idOperationFixe Int      @id @default(autoincrement())
  titre           String  @db.VarChar(50)
  montant         Decimal @db.Decimal(10, 2)
  periodicite     FixedChargePeriodicity @default(MENSUELLE)
  pourcentagePersonnel Decimal @default(100) @db.Decimal(5, 2)
  devise          String?  @db.VarChar(3)
  typeOperation  TypeOperationFixeEnum @default(CHARGE)
  User Utilisateur @relation(fields: [userId],references: [id])
  userId Int
  created_at  DateTime @default(now()) @db.Timestamp(0)
  updated_at  DateTime @default(now()) @db.DateTime(0)
  isBudgetEnvelope Boolean @default(false)
  budgetStartMonth DateTime? @db.Date
  budgetEndMonth DateTime? @db.Date
  budgetArchived Boolean @default(false)
  versions FixedOperationVersion[]
  categoryId Int?
  category OperationCategory? @relation(fields: [categoryId, userId], references: [id, userId], onDelete: Restrict)
  @@index([categoryId, userId])
  // Charge ChargeFixe? @relation(fields: [idChargeFixe],references: [typeOperation])
  // Revenu Revenu? @relation(fields: [idRevenu],references: [typeOperation])
  // idChargeFixe String?
  // idRevenu String?
  @@unique([idOperationFixe, userId])
  @@index([userId, idOperationFixe])
  @@index([userId, typeOperation, idOperationFixe])
}

enum FixedChargePeriodicity {
  MENSUELLE
  BIMESTRIELLE
  TRIMESTRIELLE
  SEMESTRIELLE
  ANNUELLE
}

model EvenementMensuel {
  id         Int                    @id @default(autoincrement())
  title      String                 @map("titre") @db.VarChar(50)
  amount     Decimal                @map("montant") @db.Decimal(10, 2)
  currency   String                 @map("devise") @db.VarChar(3)
  kind       MonthlyEventKind       @default(DEPENSE)
  startDate  DateTime               @default(dbgenerated("(curdate())")) @db.Date
  recurrence MonthlyEventRecurrence @default(AUCUNE)
  status     MonthlyEventStatus     @default(CONFIRME)
  endDate    DateTime?              @db.Date
  createdAt  DateTime               @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt  DateTime               @updatedAt @map("updated_at") @db.DateTime(0)
  user       Utilisateur            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int

  @@index([userId, startDate, id])
  @@index([userId, status, startDate, id])
}

enum MonthlyEventStatus {
  CONFIRME
  POTENTIEL
}

enum MonthlyEventKind {
  DEPENSE
  ENTREE
}

enum MonthlyEventRecurrence {
  AUCUNE
  MENSUELLE
  HEBDOMADAIRE
  TRIMESTRIELLE
  ANNUELLE
}


model Utilisateur {
  id    Int     @id @default(autoincrement())
  firstname String  @db.VarChar(50)
  lastname  String @db.VarChar(50)
  password  String @db.VarChar(120)
  email     String @db.VarChar(255) @unique
  role  Role @default(USER)
  verified Boolean @default(false)
  resetToken String?
  resetTokenExpiration DateTime?
  restantAVivreFictif ResteAVivreFictif[]
  restantAVivre ResteAVivre[]
  notifications Notification[]
  operations Operation[]
  operationsFixes OperationFixe[]
  objectifFinancier ObjectifFinancier[]
  evenementsMensuel EvenementMensuel[]
  refreshSessions RefreshSession[]
  operationCategories OperationCategory[]
  oneOffOperations OneOffOperationRecord[] @relation("OneOffOperationOwner")
  budgetPeriods BudgetPeriod[]
  occurrenceResolutions EventOccurrenceResolution[]
  budgetEnvelopes BudgetEnvelope[]
  reconciliationOccurrences ReconciliationOccurrence[]
  created_at  DateTime @default(now()) @db.Timestamp(0)
  updated_at  DateTime @default(now()) @db.DateTime(0)
}

model BudgetPeriod {
  id               Int                @id @default(autoincrement())
  periodStart      DateTime           @db.Date
  currency         String             @db.Char(3)
  status           BudgetPeriodStatus @default(OPEN)
  fixedIncome      Decimal            @db.Decimal(10, 2)
  fixedExpense     Decimal            @db.Decimal(10, 2)
  baseAmount       Decimal            @db.Decimal(10, 2)
  actualIncome     Decimal            @default(0) @db.Decimal(10, 2)
  actualExpense    Decimal            @default(0) @db.Decimal(10, 2)
  realRemaining    Decimal            @default(0) @db.Decimal(10, 2)
  /// Signed offset that prevents fixed forecast/payment duplication; frozen at closure.
  reconciliationAdjustment Decimal @default(0) @db.Decimal(14, 2)
  /// Reste réel signé du mois précédent clôturé, reporté sur cette période.
  carryIn          Decimal            @default(0) @db.Decimal(10, 2)
  unresolvedEvents Int                @default(0)
  revision         Int                @default(1)
  closedAt         DateTime?          @db.DateTime(3)
  /// Dernier recalcul d'un bilan clôturé après une correction d'opération.
  correctedAt      DateTime?          @db.DateTime(3)
  createdAt        DateTime           @default(now()) @db.Timestamp(0)
  updatedAt        DateTime           @updatedAt @db.DateTime(0)
  userId           Int
  user             Utilisateur        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periodStart, currency])
  @@index([userId, currency, periodStart, id])
}

enum BudgetPeriodStatus {
  OPEN
  CLOSED
}

/// Décision durable sur une occurrence datée; l'absence de ligne signifie PLANNED.
model EventOccurrenceResolution {
  id             Int                        @id @default(autoincrement())
  /// Référence historique à la règle, sans cascade : la décision survit à la suppression de la règle.
  sourceEventId  Int
  occurrenceDate DateTime                   @db.Date
  status         OccurrenceResolutionStatus
  title          String                     @db.VarChar(50)
  amount         Decimal                    @db.Decimal(10, 2)
  currency       String                     @db.Char(3)
  kind           MonthlyEventKind
  /// Opération créée par la réalisation; repasse à null si l'opération est supprimée ensuite.
  operationId    Int?                       @unique
  operation      OneOffOperationRecord?     @relation(fields: [operationId], references: [id], onDelete: SetNull)
  resolvedAt     DateTime                   @default(now()) @db.DateTime(3)
  createdAt      DateTime                   @default(now()) @db.Timestamp(0)
  updatedAt      DateTime                   @updatedAt @db.DateTime(0)
  userId         Int
  user           Utilisateur                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceEventId, occurrenceDate])
  @@index([userId, occurrenceDate, status, id])
  @@index([userId, currency, occurrenceDate, id])
}

enum OccurrenceResolutionStatus {
  REALIZED
  CANCELED
}

model RefreshSession {
  id        String    @id @db.VarChar(36)
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime  @db.DateTime(3)
  revokedAt DateTime? @db.DateTime(3)
  createdAt DateTime  @default(now()) @db.DateTime(3)
  updatedAt DateTime  @updatedAt @db.DateTime(3)
  userId    Int
  user      Utilisateur @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}


model Notification {
  idNotif  Int       @id @default(autoincrement())
  message  String   @db.VarChar(255)
  dateSent DateTime @db.Date
  Utilisateur Utilisateur @relation(fields:[userId], references:[id])
  userId   Int
}

model ObjectifFinancier {
  id                  Int         @id @default(autoincrement())
  title               String      @map("titre") @db.VarChar(50)
  targetAmount        Decimal     @map("montant") @db.Decimal(10, 2)
  savedAmount         Decimal     @default(0) @db.Decimal(10, 2)
  monthlyContribution Decimal     @default(0) @db.Decimal(10, 2)
  currency            String      @map("devise") @db.VarChar(3)
  targetDate          DateTime?   @map("dateObjectifAtteint") @db.Date
  created_at          DateTime    @default(now()) @db.Timestamp(0)
  updated_at          DateTime    @default(now()) @updatedAt @db.DateTime(0)
  Utilisateur         Utilisateur @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId              Int

  @@index([userId, id])
}

model OperationCategoryTemplate {
  id        Int                 @id @default(autoincrement())
  code      String              @unique @db.VarChar(32)
  name      String              @db.VarChar(50)
  color     String?             @db.Char(7)
  sortOrder Int                 @default(0)
  active    Boolean             @default(true)
  icon      String? @db.VarChar(64)
  fixedKind TypeOperationFixeEnum?
  categories OperationCategory[]
  createdAt DateTime            @default(now()) @db.Timestamp(0)
  updatedAt DateTime            @updatedAt @db.DateTime(0)
}

model OperationCategory {
  id         Int                        @id @default(autoincrement())
  name       String                     @db.VarChar(50)
  color      String?                    @db.Char(7)
  icon       String?                    @db.VarChar(64)
  userId     Int
  templateId Int?
  user       Utilisateur                @relation(fields: [userId], references: [id], onDelete: Cascade)
  template   OperationCategoryTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  fixedKind TypeOperationFixeEnum?
  fixedOperations OperationFixe[]
  budgetEnvelopes BudgetEnvelope[]
  operations OneOffOperationRecord[]
  createdAt  DateTime                   @default(now()) @db.Timestamp(0)
  updatedAt  DateTime                   @updatedAt @db.DateTime(0)

  @@unique([userId, name])
  @@unique([id, userId])
  @@index([templateId])
  @@index([userId, name, id])
}

model OneOffOperationRecord {
  id                Int               @id @default(autoincrement())
  legacyOperationId Int?              @unique
  title             String            @db.VarChar(50)
  amount            Decimal           @db.Decimal(10, 2)
  currency          String            @db.Char(3)
  type              TypeOperationEnum @default(DEPENSE)
  operationDate     DateTime          @db.Date
  userId            Int
  categoryId        Int
  owner             Utilisateur       @relation("OneOffOperationOwner", fields: [userId], references: [id], onDelete: Cascade)
  category          OperationCategory @relation(fields: [categoryId, userId], references: [id, userId], onDelete: Restrict)
  reconciliation    ReconciliationLink?
  resolution        EventOccurrenceResolution?
  createdAt         DateTime          @default(now()) @db.Timestamp(0)
  updatedAt         DateTime          @updatedAt @db.DateTime(0)

  @@unique([id, userId])
  @@index([userId, operationDate])
  @@index([userId, operationDate, id])
  @@index([userId, currency, operationDate, id])
  @@index([categoryId, userId])
}

model Operation {
  id Int      @id @default(autoincrement())
  titre       String  @db.VarChar(50)
  montant     Decimal @db.Decimal(10, 2)
  devise      String  @db.VarChar(3)
  idCategorie Int
  userId Int
  dateOperation DateTime  @db.Date
  type TypeOperationEnum @default(DEPENSE)
  User Utilisateur @relation(fields: [userId],references: [id])
  // type TypeOperation[] @relation(references:[id])
  Categorie Categorie @relation(fields: [idCategorie],references: [id])
  // ponctuel Ponctuel []
  periodique Periodique?
  created_at  DateTime @default(now()) @db.Timestamp(0)
  updated_at  DateTime @default(now()) @db.DateTime(0)
}

model Categorie {
  id Int       @id @default(autoincrement())
  categorie   String   @db.VarChar(50) @unique
  created_at  DateTime @default(now()) @db.Timestamp(0)
  updated_at  DateTime @default(now()) @db.DateTime(0)
  operations Operation[]
}

