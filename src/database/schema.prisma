generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
  // shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model Administrateur {
  idAdmin   Int     @id @default(autoincrement())
  firstname String @db.VarChar(50)
  lastname  String @db.VarChar(50)
  password  String @db.VarChar(120)
  email     String @db.VarChar(255) @unique
}

model OperationFixe {
  idOperationFixe Int      @id @default(autoincrement())
  titre           String  @db.VarChar(50)
  montant         Decimal @db.Decimal(10, 0)
  devise          String?  @db.VarChar(3)
  typeOperation  TypeOperationFixeEnum @default(CHARGE)
  // Charge ChargeFixe? @relation(fields: [idChargeFixe],references: [typeOperation])
  // Revenu Revenu? @relation(fields: [idRevenu],references: [typeOperation])
  // idChargeFixe String?
  // idRevenu String?
}

