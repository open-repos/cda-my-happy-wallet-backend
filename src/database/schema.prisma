generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Administrateur {
  idAdmin   Int     @id @default(autoincrement())
  firstname String? @db.VarChar(50)
  lastname  String? @db.VarChar(50)
  password  String? @db.VarChar(120)
  email     String? @db.VarChar(255)
}

model Categorie {
  idCategorie Int       @id @default(autoincrement())
  categorie   String?   @db.VarChar(50)
  created_at  DateTime? @default(now()) @db.Timestamp(0)
  updated_at  DateTime? @default(now()) @db.DateTime(0)
}

model ChargeFixe {
  idOperationFixe Int       @id
  idChargeFixe    Int?
  created_at      DateTime? @default(now()) @db.Timestamp(0)
  updated_at      DateTime? @default(now()) @db.DateTime(0)
}

model DEPENSE {
  idOperation Int
  idUser      Int
  created_at  DateTime? @default(now()) @db.Timestamp(0)
  updated_at  DateTime? @default(now()) @db.DateTime(0)

  @@id([idOperation, idUser])
}

model ENTREE {
  idOperation Int
  idUser      Int
  created_at  DateTime? @default(now()) @db.Timestamp(0)
  updated_at  DateTime? @default(now()) @db.DateTime(0)

  @@id([idOperation, idUser])
}

model EvenementMensuel {
  idListEventObject  Int       @id
  idEvenementMensuel Int?
  date               DateTime? @db.Date
  created_at         DateTime? @default(now()) @db.Timestamp(0)
  updated_at         DateTime? @default(now()) @db.DateTime(0)
}

model ListeEventObj {
  idListEventObject Int      @id @default(autoincrement())
  titre             String?  @db.VarChar(50)
  montant           Decimal? @db.Decimal(10, 0)
  devise            String?  @db.VarChar(3)
}

model Notification {
  idNotif  Int       @id @default(autoincrement())
  message  String?   @db.VarChar(255)
  dateSent DateTime? @db.Date
  idUser   Int?
}

model ObjectifFinancier {
  idListEventObject   Int       @id
  idObjectifFinancier Int?
  dateObjectifAtteint DateTime? @db.Date
  created_at          DateTime? @default(now()) @db.Timestamp(0)
  updated_at          DateTime? @default(now()) @db.DateTime(0)
}

model Operation {
  idOperation Int      @id @default(autoincrement())
  titre       String?  @db.VarChar(50)
  montant     Decimal? @db.Decimal(10, 0)
  devise      String?  @db.VarChar(3)
  idCategorie Int?
}

model OperationFixe {
  idOperationFixe Int      @id @default(autoincrement())
  titre           String?  @db.VarChar(50)
  montant         Decimal? @db.Decimal(10, 0)
  devise          String?  @db.VarChar(3)
}

model Periodique {
  idOperation    Int       @id
  periode        String?   @db.VarChar(7)
  occurence      Int?
  debutOccurence DateTime? @db.Date
  finOccurence   DateTime? @db.Date
}

model Ponctuel {
  idOperation Int @id
}

model ResteAVivre {
  idRaV               Int       @id @default(autoincrement())
  montantRaV          Decimal?  @db.Decimal(10, 0)
  montantTotalDepense Decimal?  @db.Decimal(10, 0)
  montantTotalEntree  Decimal?  @db.Decimal(10, 0)
  created_at          DateTime? @default(now()) @db.Timestamp(0)
  updated_at          DateTime? @default(now()) @db.DateTime(0)
  idOperationFixe     Int?
}

model ResteAVivreFictif {
  idRaVf              Int       @id @default(autoincrement())
  montantRaVf         Decimal?  @db.Decimal(10, 0)
  montantTotalDepense Decimal?  @db.Decimal(10, 0)
  montantTotalEntree  Decimal?  @db.Decimal(10, 0)
  created_at          DateTime? @default(now()) @db.Timestamp(0)
  updated_at          DateTime? @default(now()) @db.DateTime(0)
  idUser              Int?
}

model Revenu {
  idOperationFixe Int       @id
  idRevenu        Int?
  created_at      DateTime? @default(now()) @db.Timestamp(0)
  updated_at      DateTime? @default(now()) @db.DateTime(0)
}

model Utilisateur {
  idUser    Int     @id @default(autoincrement())
  firstname String  @db.VarChar(50)
  lastname  String? @db.VarChar(50)
  password  String? @db.VarChar(120)
  email     String? @db.VarChar(255)
  idRaV     Int?
}
